#!/usr/bin/env python3
"""Cross-Model-Review: ein ZWEITES Modell liest den Diff gegen.

Sinn: Ein Modell, das seinen eigenen Code reviewt, findet vor allem, was es eh
schon dachte. Der Wert liegt in der Modell-Diversitaet - nicht in Personas.

  tools/agent_review                      # uncommittete Aenderungen (Default)
  tools/agent_review --base main          # Diff gegen main
  tools/agent_review --commit HEAD        # ein bestimmter Commit
  tools/agent_review --repo kurier        # anderes Repo
  tools/agent_review --prompt "Fokus: Fehlerbehandlung in der API"

Das Ergebnis landet im gemeinsamen Review-Speicher (`review_gate.py --store`,
per Default <git-common-dir>/workflow-guard/reviews/) und wird in
.agents/command_runs.jsonl als Evidenz protokolliert - damit ist "wurde
gegengelesen" ein belegbarer Claim (type: command) und keine Behauptung.
Der Speicher haengt bewusst am gemeinsamen git-Verzeichnis statt am Arbeitsbaum:
sonst stirbt der Beleg mit `git worktree remove` (siehe store_dir() im Gate).

Backend ist die lokale codex-CLI (`codex exec review`). Fehlt sie, bricht das
Script ehrlich ab, statt ein Review vorzutaeuschen.

Ungetrackte Dateien werden vor dem Lauf per `git add -N` in den Diff gehoben und
danach wieder zurueckgesetzt - siehe mark_intent_to_add(). Ohne das reviewte das
Zweitmodell neue Dateien nicht, waehrend das Gate sie mitfingerprintete.
"""

import argparse
import datetime
import fcntl
import json
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys

# Bewusste Wahl, NICHT die codex-Konfiguration erben lassen:
# ~/.codex/config.toml hat model_reasoning_effort = "low" - fuer interaktives
# Arbeiten sinnvoll, fuer einen Reviewer falsch. Gegenlesen ist die haerteste
# Denkaufgabe in der Kette, nicht die billigste.
#
# Modellwahl, zwei Schritte:
#
# 2026-07-14: gpt-5.5 und gpt-5.6-terra auf denselben Commit angesetzt - terra
# fand alles von 5.5 PLUS einen dritten echten Bug und stufte die schwerste
# Luecke korrekt als P1 ein (5.5: P2). sol war damals ueber einen
# ChatGPT-Account gesperrt.
#
# 2026-07-31: Die Sperre gilt nicht mehr (`codex exec --model gpt-5.6-sol`
# laeuft durch, nachgemessen). Deshalb hier sol - das staerkste verfuegbare
# Modell fuer die haerteste Aufgabe der Kette.
#
# Bewusst NUR hier: agent_hunt und agent_plan_review bleiben auf terra. Beide
# beruehren das Gate nicht, und alle drei teilen denselben Kontingent-Pool -
# ein teures Modell ueberall waere der schnellste Weg, das Gate per leerem
# Kontingent selbst zu blockieren.
DEFAULT_MODEL = "gpt-5.6-sol"

# Effort ist bei "medium" gedeckelt (Nutzervorgabe 2026-07-14, bei der
# Umstellung auf sol am 2026-07-31 ausdruecklich bestaetigt). "high" ist bewusst
# KEINE Option: ein Review-Lauf auf hohem Effort frisst spuerbar Kontingent, und
# ein Gate, das das Kontingent leerlaeuft, blockiert am Ende alles. Mit sol
# gilt das erst recht. Nicht die codex-Konfiguration erben lassen - die steht
# auf "low".
EFFORT_CHOICES = ["low", "medium"]
DEFAULT_EFFORT = "medium"


def now():
    return datetime.datetime.now().isoformat(timespec="seconds")


def record_command(repo, command, exit_code):
    agents = repo / ".agents"
    agents.mkdir(exist_ok=True)
    with (agents / "command_runs.jsonl").open("a", encoding="utf-8") as f:
        f.write(
            json.dumps(
                {"command": command, "exit_code": exit_code, "ts": now()},
                ensure_ascii=False,
            )
            + "\n"
        )


class GateQueryError(RuntimeError):
    """Das Gate ist da, konnte aber nicht antworten - Umfang unbekannt."""


def gate_query(repo, flag):
    """review_gate.py ist die einzige Quelle fuer Basislinie und Fingerabdruck.

    None heisst NUR "in diesem Repo gibt es kein Gate". Ein gescheiterter Aufruf
    wirft, statt ebenfalls None zu liefern: Sonst fiel das Script stillschweigend
    auf --uncommitted zurueck, reviewte also weniger als angenommen, und schrieb
    anschliessend ueber worktree_fingerprint trotzdem einen Beleg - der auch
    lokale Commits abdeckte, die nie jemand gelesen hatte.
    (Cross-Model-Review 2026-07-31, P1.)
    """
    gate = repo / "scripts" / "review_gate.py"
    if not gate.exists():
        return None
    r = subprocess.run(
        ["python3", str(gate), flag],
        cwd=repo,
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        detail = (r.stderr or "").strip() or f"Exit {r.returncode}"
        raise GateQueryError(f"review_gate.py {flag}: {detail}")
    return (r.stdout or "").strip() or None


# So viele Belege bleiben im gemeinsamen Log stehen. Muss zu MAX_RECORDS in
# review_gate.py passen: was hier weggeworfen wird, kann das Gate nicht mehr
# finden. Es ist eine kurze Historie, kein Archiv - sie existiert nur, damit
# parallele Worktrees sich nicht gegenseitig entwerten.
RECORD_HISTORY = 20


def review_store(repo):
    """Wohin der Beleg gehoert - die Antwort gibt das Gate, nicht dieses Script.

    Aus demselben Grund wie beim Fingerabdruck: zwei Meinungen ueber den Ort
    heissen, dass einer hierhin schreibt und der andere dort liest - und das
    Gate findet nie einen Beleg. Fehlt das Gate-Script, bleibt es beim alten
    Arbeitsbaum-Pfad; ohne Gate gibt es ohnehin nichts freizugeben.
    """
    told = gate_answer(repo, "--store")
    return pathlib.Path(told) if told else repo / ".agents" / "reviews"


def claim_file(store, name):
    """Einen freien Dateinamen im gemeinsamen Speicher belegen - atomar.

    Der Zeitstempel im Namen ist sekundengenau, und seit alle Arbeitsbaeume
    denselben Speicher teilen, koennen zwei Reviews im selben Modus in derselben
    Sekunde landen. Vorher lagen sie in getrennten Verzeichnissen, jetzt wuerde
    der zweite den ersten ueberschreiben - und beide Belege zeigten auf dieselbe
    Datei. Ausgerechnet das laengere Review waere weg.
    (Cross-Model-Review 2026-08-04, P2.)

    O_EXCL statt "existiert die Datei schon?": zwischen Frage und Antwort passt
    der andere Prozess.
    """
    stem, dot, ext = name.partition(".")
    n = 0
    while True:
        cand = store / (name if n == 0 else f"{stem}-{n}{dot}{ext}")
        try:
            fd = os.open(cand, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        except FileExistsError:
            n += 1
            continue
        os.close(fd)
        return cand


def safe_name(text):
    """Alles, was in einem Dateinamen einen Pfad aufmachen wuerde, entschaerfen."""
    return re.sub(r"[^A-Za-z0-9._-]+", "-", text).strip("-") or "review"


def append_record(store, record):
    """Beleg an die gemeinsame Historie haengen und sie kurz halten.

    Angehaengt statt neu geschrieben: parallele Worktrees schreiben in dieselbe
    Datei, und ein Lesen-Aendern-Schreiben wuerde dabei fremde Zeilen verlieren.
    Gekuerzt wird erst, wenn die Datei deutlich zu lang ist - selten, und dann
    faellt hoechstens ein laengst ueberholter Beleg weg.

    Das Kuerzen ist aber trotzdem ein Lesen-Aendern-Schreiben: Prozess A liest
    die Zeilen, B haengt seinen Beleg an, A schreibt seinen Schnappschuss zurueck
    und Bs Beleg ist weg - der Nachbar-Worktree muesste sein Review wiederholen.
    Deshalb laufen Anhaengen und Kuerzen unter einer Dateisperre, und ersetzt
    wird per os.replace: ein Leser sieht so entweder die alte oder die neue
    Datei, nie eine halb geschriebene. (Cross-Model-Review 2026-08-04, P2.)

    Die Sperre liegt auf einer EIGENEN Datei, nicht auf dem Log: das Log wird
    beim Kuerzen ersetzt, und eine Sperre auf der ersetzten Datei bewacht danach
    niemanden mehr.

    Ohne Sperre wird NUR angehaengt, nie gekuerzt: das Anhaengen einer Zeile ist
    auch ungesperrt gutartig, das Kuerzen nicht - es ginge ueber eine gemeinsame
    temporaere Datei und koennte einen fremden Schnappschuss zerreissen. Dann
    waechst das Log eben. Ein zu langes Log kostet nichts, ein verlorener Beleg
    ein ganzes Review. (Cross-Model-Review 2026-08-04, dritte Runde.)
    """
    log = store / "records.jsonl"
    lock = store / "records.lock"
    line = json.dumps(record, ensure_ascii=False) + "\n"
    with lock.open("a", encoding="utf-8") as lk:
        try:
            fcntl.flock(lk.fileno(), fcntl.LOCK_EX)
            locked = True
        except OSError:
            # Dateisystem ohne flock (Netzlaufwerk): ungesperrt anhaengen ist
            # immer noch besser als den Beleg gar nicht zu schreiben.
            locked = False
        with log.open("a", encoding="utf-8") as f:
            f.write(line)
        if not locked:
            return
        try:
            lines = [ln for ln in log.read_text(encoding="utf-8").splitlines() if ln.strip()]
        except OSError:
            return
        if len(lines) > 2 * RECORD_HISTORY:
            tmp = log.with_name(log.name + ".tmp")
            tmp.write_text("\n".join(lines[-RECORD_HISTORY:]) + "\n", encoding="utf-8")
            os.replace(tmp, log)


def gate_answer(repo, *flags):
    """Antwort des Gates oder None - die stille Variante von gate_query().

    Fuer den Beleg am Ende: laesst sich etwas nicht ermitteln, wird eben kein
    Beleg geschrieben. Lieber kein Beleg als ein falscher.
    """
    gate = repo / "scripts" / "review_gate.py"
    if not gate.exists():
        return None
    r = subprocess.run(
        ["python3", str(gate), *flags],
        cwd=repo,
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        return None
    return (r.stdout or "").strip() or None


def worktree_fingerprint(repo, base=None):
    """Fingerabdruck der geaenderten Code-Dateien.

    Bewusst KEINE eigene Implementierung: scripts/review_gate.py ist die einzige
    Quelle. Zwei Kopien wuerden auseinanderdriften und dann passt kein Review
    mehr zu keinem Gate. Fehlt das Script, gibt es keinen Fingerabdruck - dann
    wird auch kein last_review.json geschrieben (lieber kein Beleg als ein
    falscher).

    `base` festzunageln ist noetig, weil dieser Wert zweimal erhoben wird - vor
    und nach dem Review. Ohne feste Basislinie kann ein Beleg aus einem
    parallelen Worktree sie dazwischen verschieben, und ein korrektes Review
    faellt durch die Gleichheitspruefung.
    """
    if base:
        return gate_answer(repo, "--fingerprint", base)
    return gate_answer(repo, "--fingerprint")


def git_head(repo):
    """Aktueller HEAD oder leerer String."""
    return (
        subprocess.run(
            ["git", "rev-parse", "HEAD"], cwd=repo, capture_output=True, text=True
        ).stdout
        or ""
    ).strip()


def reviewed_state(repo, base):
    """Was der Reviewer sieht - HEAD und Fingerabdruck gegen eine FESTE Basis.

    Wird einmal vor und einmal nach dem Review erhoben. Stimmen beide nicht
    ueberein, hat sich waehrend des Laufs etwas bewegt (Nachbar-Worktree,
    eigener Commit, Editor) - dann darf kein Beleg entstehen.

    Die Basislinie steckt bewusst NICHT im Vergleich, sondern wird von aussen
    festgenagelt: sie kann sich waehrend des Laufs voellig legitim nach vorn
    bewegen, wenn nebenan ein Review fertig wird. Das aendert nichts daran, was
    dieser Reviewer gelesen hat - er hat dann sogar mehr gesehen als noetig.
    """
    return (git_head(repo), worktree_fingerprint(repo, base))


def nul_separated(result):
    """Pfade aus einer -z-Ausgabe.

    IMMER -z verwenden, nie splitlines(): ohne -z escaped git Pfade mit
    Sonderzeichen ("sch\\303\\266n.py" statt schön.py, Umbrueche als \\n). Dieser
    escapte Text ist kein existierender Pfad - `git add -N` scheitert daran mit
    "pathspec did not match any files", und seit der Fail-closed-Regel bricht
    damit JEDES Review in so einem Worktree ab (Cross-Model-Review 2026-07-28).

    Schlaegt der git-Aufruf selbst fehl, kommt None zurueck, KEINE leere Liste:
    "keine Pfade" und "Abfrage gescheitert" duerfen nicht zusammenfallen, sonst
    laeuft das Review ohne intent-to-add-Marker weiter und zertifiziert
    ungetrackte Dateien erneut ungesehen (Cross-Model-Review 2026-07-30, P2).
    """
    if result.returncode != 0:
        return None
    return [p for p in (result.stdout or "").split("\0") if p]


def untracked_paths(repo):
    """Ungetrackte, nicht ignorierte Dateien - dieselbe Menge wie im Gate.

    None bei gescheiterter git-Abfrage; der Aufrufer MUSS dann abbrechen
    (fail closed, wie mark_intent_to_add).
    """
    return nul_separated(
        subprocess.run(
            ["git", "ls-files", "--others", "--exclude-standard", "-z"],
            cwd=repo,
            capture_output=True,
            text=True,
        )
    )


def mark_intent_to_add(repo, paths):
    """Ungetrackte Dateien in den Diff heben, den das Zweitmodell zu sehen bekommt.

    Warum ueberhaupt: `codex exec review --uncommitted` sagt laut Hilfe "staged,
    unstaged, and untracked" zu - haelt das aber nicht verlaesslich. Am
    2026-07-27 reviewte es in investors-club-global eine Aenderung aus 7 neuen
    Dateien, sah KEINE davon und meldete stattdessen, die Implementierung fehle.
    In einem Mini-Repo klappte es. Der Unterschied ist nicht ermittelt und ist
    auch egal: ein Gate darf nicht davon abhaengen, ob ein Modell zufaellig
    nachschaut.

    Das ist kein Kosmetikfehler. `review_gate.py` fingerprintet ungetrackte
    Dateien MIT (changed_code_paths), das Review sah sie aber nicht - ein
    erfolgreicher Lauf schrieb also last_review.json fuer einen Stand, den nie
    jemand gelesen hat. Das Gate zertifizierte ungeprueften Code als geprueft,
    genau die Klasse Fehler, gegen die es gebaut wurde.

    `git add -N` legt nur einen leeren Blob in den Index: der Diff zeigt die
    Datei als komplette Neuanlage, der Arbeitsbaum bleibt unberuehrt. Gilt fuer
    `--uncommitted` UND `--base <sha>`, deckt also beide Default-Pfade ab.

    Gibt die Pfade zurueck, die WIRKLICH markiert wurden - nur die duerfen
    hinterher zurueckgesetzt werden. Ein pauschales `git reset` wuerde dem Nutzer
    bewusst gestagete Aenderungen wegnehmen.

    Bei einem Fehler (z.B. .git/index.lock von einem parallelen git-Prozess)
    kommt None zurueck, KEINE leere Liste: der Aufrufer muss dann abbrechen.
    Weiterlaufen hiesse, mit genau dem Blindfleck zu reviewen, gegen den diese
    Funktion gebaut ist - und am Ende last_review.json dafuer zu schreiben
    (Cross-Model-Review 2026-07-28, P1).
    """
    if not paths:
        return []
    r = subprocess.run(
        ["git", "add", "-N", "--", *paths],
        cwd=repo,
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        print(
            "FEHLER: ungetrackte Dateien liessen sich nicht in den Diff heben.",
            file=sys.stderr,
        )
        print((r.stderr or "").strip(), file=sys.stderr)
        print(
            "Ohne sie waere das Review blind fuer neue Dateien - und wuerde den Stand\n"
            "trotzdem freigeben. Lieber kein Review als ein falscher Beleg.",
            file=sys.stderr,
        )
        return None
    return paths


def really_staged(repo):
    """Pfade mit echtem Index-Inhalt.

    Trennscharf gegen intent-to-add: `git add -N` legt nur einen Platzhalter an,
    solche Eintraege tauchen in `git diff --cached` NICHT auf, echt gestagete
    dagegen schon.

    None bei gescheiterter git-Abfrage - der Aufrufer darf dann NICHT
    zuruecksetzen, sonst reset er womoeglich echt gestagete Arbeit.
    """
    staged = nul_separated(
        subprocess.run(
            ["git", "diff", "--cached", "--name-only", "-z"],
            cwd=repo,
            capture_output=True,
            text=True,
        )
    )
    return None if staged is None else set(staged)


def unmark_intent_to_add(repo, paths):
    """Markierung zuruecknehmen: die Dateien sind danach wieder ungetrackt.

    Nur die selbst markierten Pfade, nie der ganze Index (s.o.). Laeuft im
    finally-Zweig, damit ein abgebrochener oder fehlgeschlagener Review den
    Index des Nutzers nicht veraendert zuruecklaesst.

    Ein Review dauert Minuten. Staged der Nutzer (oder eine parallele Session)
    in dieser Zeit eine dieser Dateien wirklich, wuerde ein blindes `git reset`
    ihm diese Arbeit wegnehmen. Deshalb kurz vor dem Zuruecksetzen erneut
    pruefen, welche Pfade noch reine intent-to-add-Eintraege sind - nur die
    anfassen (Cross-Model-Review 2026-07-28, P2).

    Scheitert das Zuruecksetzen (Index-Lock), bleibt der Index veraendert. Das
    still zu schlucken waere ein gebrochenes Versprechen, das niemand bemerkt -
    also laut melden, mit dem Befehl zum Selberrichten. Die Gate-Korrektheit
    haengt nicht daran: intent-to-add aendert keine Dateiinhalte, der
    Fingerabdruck bleibt derselbe.
    """
    if not paths:
        return
    staged_meanwhile = really_staged(repo)
    if staged_meanwhile is None:
        # Nicht feststellbar, was inzwischen echt gestaged wurde: lieber die
        # harmlosen Marker stehen lassen als fremde Arbeit zuruecksetzen.
        print(
            f"WARNUNG: {len(paths)} intent-to-add-Marker bleiben stehen "
            "(git diff --cached scheiterte).",
            file=sys.stderr,
        )
        print(f"  Selbst richten: git reset -- {' '.join(paths)}", file=sys.stderr)
        return
    paths = [p for p in paths if p not in staged_meanwhile]
    if not paths:
        return
    r = subprocess.run(
        ["git", "reset", "--quiet", "--", *paths],
        cwd=repo,
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        print(
            f"WARNUNG: {len(paths)} Datei(en) bleiben als intent-to-add im Index stehen.",
            file=sys.stderr,
        )
        print((r.stderr or "").strip(), file=sys.stderr)
        print("Selbst zuruecksetzen mit:", file=sys.stderr)
        print(
            f"  git reset -- {' '.join(shlex.quote(p) for p in paths)}",
            file=sys.stderr,
        )


def find_codex():
    """Die Tool-Shell hat nicht denselben PATH wie die Login-Shell."""
    exe = shutil.which("codex")
    if exe:
        return exe
    for cand in (
        "/usr/local/bin/codex",
        "/opt/homebrew/bin/codex",
        os.path.expanduser("~/.local/bin/codex"),
    ):
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--repo", default=".", help="Repo-Pfad (Default: aktuelles Verzeichnis)")
    scope = ap.add_mutually_exclusive_group()
    scope.add_argument("--base", metavar="BRANCH", help="Diff gegen diesen Branch reviewen")
    scope.add_argument("--commit", metavar="SHA", help="diesen Commit reviewen")
    scope.add_argument(
        "--uncommitted",
        action="store_true",
        help=(
            "staged + unstaged + untracked "
            "(Default; ungetrackte werden per git add -N sichtbar gemacht)"
        ),
    )
    ap.add_argument("--prompt", help="zusaetzlicher Fokus fuer den Reviewer")
    ap.add_argument(
        "--model",
        default=DEFAULT_MODEL,
        help=f"Modell des Zweitlesers (Default: {DEFAULT_MODEL})",
    )
    ap.add_argument(
        "--effort",
        default=DEFAULT_EFFORT,
        choices=EFFORT_CHOICES,
        help=f"Reasoning-Effort, gedeckelt bei medium (Default: {DEFAULT_EFFORT})",
    )
    args = ap.parse_args()

    repo = pathlib.Path(args.repo).resolve()
    if not (repo / ".git").exists():
        print(f"FEHLER: kein Git-Repo: {repo}", file=sys.stderr)
        return 2

    # Fehlt das Werkzeug, wird hier abgebrochen - ein Review, das nicht laufen
    # kann, darf nicht so aussehen, als haette es nichts gefunden.
    backend_bin = find_codex()
    if not backend_bin:
        print(
            "FEHLER: codex-CLI nicht gefunden. Kein Zweitmodell = kein Review.",
            file=sys.stderr,
        )
        print("Kein Review vorzutaeuschen ist besser als ein erfundenes.", file=sys.stderr)
        return 2

    # Standardfall: ALLES Ungepruefte lesen. Die Basislinie kommt vom Gate -
    # sie schliesst lokale, noch nicht gegengelesene Commits ein. Frueher wurde
    # nur der Arbeitsbaum geprueft; wer vorher committete, umging das Gate
    # komplett (Cross-Model-Review 2026-07-14, P1).
    head = git_head(repo)

    # scope_flags fahren den Review-Modus der codex-CLI, scope_desc beschreibt
    # denselben Umfang in Worten - gebraucht wird die Beschreibung, sobald
    # --prompt den Scope in die Instruktion einbettet (siehe unten).
    releases_worktree = False
    base = None
    if args.base:
        scope_flags = ["--base", args.base]
        scope_desc = f"die Aenderungen gegenueber Branch {args.base}"
        mode = f"base-{args.base}"
    elif args.commit:
        scope_flags = ["--commit", args.commit]
        scope_desc = f"die Aenderungen des Commits {args.commit}"
        mode = f"commit-{args.commit[:8]}"
    else:
        try:
            base = gate_query(repo, "--baseline")
        except GateQueryError as e:
            print(f"FEHLER: {e}", file=sys.stderr)
            print(
                "Ohne Basislinie ist der Review-Umfang unbekannt - der Lauf wuerde "
                "weniger lesen als er anschliessend beglaubigt.",
                file=sys.stderr,
            )
            print("Lieber kein Review als ein falscher Beleg.", file=sys.stderr)
            record_command(repo, "agent_review --unreviewed", 2)
            return 2
        if base and base != head:
            scope_flags = ["--base", base]
            scope_desc = f"alle Aenderungen seit {base} (Commits und Arbeitsbaum)"
            mode = "unreviewed"
        else:
            scope_flags = ["--uncommitted"]
            scope_desc = "die uncommitteten Aenderungen (staged, unstaged und untracked)"
            mode = "uncommitted"
        releases_worktree = True

    cmd = [backend_bin, "exec", "review", "--model", args.model]
    # Effort pro Aufruf setzen, statt den globalen "low"-Default zu erben.
    # -c ueberschreibt config.toml nur fuer diesen Lauf; die interaktive
    # codex-Nutzung des Users bleibt unangetastet.
    cmd += ["-c", f"model_reasoning_effort={args.effort!r}".replace("'", '"')]
    # Die codex-CLI erlaubt den Positional-Prompt nicht zusammen mit
    # --base/--commit/--uncommitted (Custom-Instructions sind dort ein eigener,
    # vierter Review-Modus). Mit --prompt wird der Scope deshalb in die
    # Instruktion eingebettet statt als Flag uebergeben.
    if args.prompt:
        cmd += [f"Reviewe {scope_desc}. Zusaetzlicher Fokus: {args.prompt}"]
    else:
        cmd += scope_flags

    # Ueberall, wo der Arbeitsbaum im Scope ist. Das schliesst --base ein:
    # `git diff <base>` vergleicht den ARBEITSBAUM gegen die Basis, nicht HEAD -
    # getrackte Worktree-Aenderungen sind dort also drin, und ungetrackte
    # auszunehmen waere derselbe Blindfleck in einem anderen Modus
    # (Cross-Model-Review 2026-07-28). Nur --commit bleibt aussen vor: das ist
    # ein abgeschlossener Commit-Diff, in dem der Arbeitsbaum nichts zu suchen hat.
    # Stand VOR dem Review festhalten - erhoben, bevor `git add -N` etwas
    # markiert, damit er mit der Erhebung danach (nach dem Zuruecksetzen)
    # vergleichbar ist.
    #
    # Die Basislinie wird NICHT neu erfragt, sondern ist genau die von oben, aus
    # der der Diff gebaut wurde. Eine zweite Abfrage koennte eine andere Antwort
    # bekommen: schreibt eine parallele Sitzung dazwischen einen Beleg mit
    # aelterem Stand, rutscht die Basislinie nach HINTEN. Der Beleg deckte dann
    # mehr ab, als im Diff stand - genau der Fehler, den diese Pruefung
    # verhindern soll. (Cross-Model-Review 2026-08-04, dritte Runde.)
    pinned_base = (base or head) if releases_worktree else None
    pre_state = reviewed_state(repo, pinned_base) if releases_worktree else None

    if args.commit:
        marked = []
    else:
        untracked = untracked_paths(repo)
        if untracked is None:
            # Fail closed: ohne diese Liste bekaeme das Zweitmodell neue
            # Dateien nie zu sehen und wuerde den Stand trotzdem freigeben.
            print(
                "FEHLER: git konnte ungetrackte Dateien nicht auflisten "
                "(git ls-files --others scheiterte).",
                file=sys.stderr,
            )
            print("Lieber kein Review als ein falscher Beleg.", file=sys.stderr)
            record_command(repo, f"agent_review --{mode.split('-')[0]}", 2)
            return 2
        marked = mark_intent_to_add(repo, untracked)
    if marked is None:
        record_command(repo, f"agent_review --{mode.split('-')[0]}", 2)
        return 2

    print(
        f"Zweitmodell liest gegen: {repo.name} ({mode}) [codex: {args.model}, effort={args.effort}]"
    )
    if marked:
        print(f"  + {len(marked)} ungetrackte Datei(en) in den Diff gehoben")

    try:
        print(f"$ {' '.join(cmd)}\n")
        # Ueber die LOGIN-Shell starten: codex braucht CODEX_HOME/
        # OPENAI_API_KEY aus der zshrc. Ein direkter subprocess erbt die
        # nicht und laeuft in einen irrefuehrenden "Login abgelaufen"-Fehler.
        shell_cmd = " ".join(shlex.quote(c) for c in cmd)
        proc = subprocess.run(["zsh", "-lic", shell_cmd], cwd=repo, capture_output=True, text=True)
        output = (proc.stdout or "") + (proc.stderr or "")
        returncode = proc.returncode
    finally:
        unmark_intent_to_add(repo, marked)

    # NUR echte codex-Fehlerzeilen auswerten, nicht die gesamte Ausgabe.
    #
    # Vorher wurde im kompletten Output gesucht - und der enthaelt den REVIEWTEN
    # CODE. Sobald Codex dieses Script selbst reviewte, las der Detektor seine
    # eigenen Suchmuster ("token_expired", "401 Unauthorized", ...) im Diff und
    # meldete faelschlich "Login abgelaufen". Ein Mechanismus, der sich selbst
    # liest und daran scheitert. codex meldet echte Fehler als "ERROR: ..." und
    # endet dann mit exit != 0 - beides muss zutreffen.
    error_lines = "\n".join(
        line for line in output.splitlines() if line.strip().startswith("ERROR:")
    )
    failed = returncode != 0

    auth_broken = failed and any(
        s in error_lines
        for s in (
            "token_expired",
            "401 Unauthorized",
            "refresh token was already used",
            "Please log out and sign in again",
        )
    )
    if auth_broken:
        print("REVIEW NICHT GELAUFEN: codex-Login abgelaufen.", file=sys.stderr)
        print("Behebung (interaktives Terminal noetig):  codex login", file=sys.stderr)
        record_command(repo, f"agent_review --{mode.split('-')[0]}", 2)
        return 2

    # Kontingent erschoepft sieht sonst aus wie ein Review, das nichts gefunden hat.
    # Auch hier nur echte Fehlerzeilen, aus demselben Grund.
    quota_hit = failed and any(
        s in error_lines
        for s in ("hit your usage limit", "usage_limit_reached", "rate_limit_exceeded")
    )
    if quota_hit:
        print("REVIEW NICHT GELAUFEN: codex-Kontingent erschoepft.", file=sys.stderr)
        for line in output.splitlines():
            if "usage limit" in line:
                print(f"  {line.strip()}", file=sys.stderr)
                break
        print(
            "Optionen: warten bis zum Reset, Plan upgraden, oder das Gate im Repo "
            "abschalten (.agents/review_required loeschen).",
            file=sys.stderr,
        )
        record_command(repo, f"agent_review --{mode.split('-')[0]}", 2)
        return 2

    print(output)

    reviews = review_store(repo)
    reviews.mkdir(parents=True, exist_ok=True)
    stamp = now().replace(":", "").replace("-", "")
    # `mode` traegt den Branch- bzw. Commit-Namen und darf so nicht in einen
    # Dateinamen: `--base origin/main` ergab "base-origin/main.md", und os.open
    # brach mit "No such file or directory" ab - der Review war gelaufen, der
    # Beleg fiel weg. Aufgefallen beim Lauf gegen origin/main am 2026-08-05.
    out_file = claim_file(reviews, f"{stamp}-{safe_name(mode)}.md")
    out_file.write_text(
        f"# Cross-Model-Review ({mode})\n\n"
        f"- Zeitpunkt: {now()}\n"
        f"- Repo: {repo.name}\n"
        f"- Backend: codex ({backend_bin}, Modell {args.model})\n"
        f"- Exit: {returncode}\n\n"
        f"---\n\n{output}\n",
        encoding="utf-8",
    )

    record_command(repo, f"tools/agent_review --{mode.split('-')[0]}", returncode)

    # Nur ein GELUNGENES Review des ARBEITSBAUMS darf ihn freigeben.
    #
    # Frueher wurde last_review.json auch nach --commit/--base geschrieben - mit
    # dem Fingerabdruck des aktuellen Arbeitsbaums, obwohl Codex einen ganz
    # anderen Diff gelesen hatte. Damit konnte man das Gate austricksen: einen
    # alten Commit reviewen lassen und der ungeprueft daneben liegende Code galt
    # als freigegeben. (Cross-Model-Review 2026-07-14, als P1 gemeldet.)
    #
    if returncode == 0 and releases_worktree:
        # Die Basislinie gehoert IN den Beleg: der Fingerabdruck haengt an ihr,
        # und ohne sie rechnet das Gate spaeter gegen eine andere und findet nie
        # eine Uebereinstimmung. Genommen wird die VOM ANFANG des Laufs - sie
        # beschreibt den Umfang, den der Reviewer gelesen hat.
        #
        # Der Stand wird hier GEGEN den Stand von vorher geprueft. Frueher
        # entstand der Fingerabdruck erst nach dem Review, waehrend der HEAD im
        # Beleg aus der Zeit davor stammte: bewegte sich der Arbeitsbaum
        # dazwischen, beschrieb der Beleg einen Stand, den der Reviewer nie
        # gesehen hat - und das Gate gab ihn spaeter frei. Ungleich heisst
        # deshalb: kein Beleg, neu reviewen. (Cross-Model-Review 2026-08-04, P1.)
        base_covered = pinned_base
        post_state = reviewed_state(repo, base_covered)
        head_now, fp = post_state
        if pre_state != post_state:
            print(
                "HINWEIS: Der Stand hat sich waehrend des Reviews geaendert - "
                "kein Beleg geschrieben, das Gate bleibt zu.",
                file=sys.stderr,
            )
            print(
                "Der Reviewer hat einen anderen Stand gelesen als den jetzigen. "
                "Review nach Abschluss der Aenderungen wiederholen.",
                file=sys.stderr,
            )
        elif fp and base_covered:
            record = {
                "ts": now(),
                "mode": mode,
                "base": base_covered,
                "head": head_now,
                "fingerprint": fp,
                "file": out_file.name,
            }
            (reviews / "last_review.json").write_text(
                json.dumps(record, ensure_ascii=False, indent=2) + "\n",
                encoding="utf-8",
            )
            append_record(reviews, record)
    elif returncode == 0:
        print(
            f"HINWEIS: {mode}-Review gibt den Stand NICHT frei "
            "(dafuer agent_review ohne --commit/--base).",
            file=sys.stderr,
        )

    try:
        where = out_file.relative_to(repo)
    except ValueError:
        # Der Speicher haengt am gemeinsamen git-Verzeichnis. Aus einem Worktree
        # heraus liegt er damit ausserhalb des Arbeitsbaums - dann den ganzen
        # Pfad zeigen, sonst findet ihn niemand wieder.
        where = out_file
    print(f"\nReview gespeichert: {where}")
    if returncode != 0:
        print(
            "HINWEIS: Reviewer endete mit Fehler - Ergebnis ist unvollstaendig.",
            file=sys.stderr,
        )
    return returncode


if __name__ == "__main__":
    sys.exit(main())
