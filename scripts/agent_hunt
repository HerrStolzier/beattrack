#!/usr/bin/env python3
"""Cross-Model-Hunt: ein ZWEITES Modell sucht die Root Cause eines Bugs.

Sinn: Ein Modell, das seinen eigenen Bug jagt, sucht dort, wo es den Code
ohnehin schon verstanden zu haben glaubt. Der Wert liegt in der
Modell-Diversitaet - ein frischer Blick ohne die Vorannahmen der Session.

  tools/agent_hunt "Beschreibung des Problems"
  tools/agent_hunt --repo kurier "Cronjob schreibt seit 3 Tagen keine Zeilen"
  tools/agent_hunt --hint "Verdacht: ranker.ts" "Shorts bekommen falsches Topic"

Der Ermittler laeuft READ-ONLY und liefert Hypothesen mit Belegstellen - KEINE
Fixes. Das Ergebnis landet in <repo>/.agents/hunts/<ts>.md und wird in
.agents/command_runs.jsonl als Evidenz protokolliert.

Zwei Backends, Default ist `codex`:
  --backend codex   die lokale codex-CLI (Default)
  --backend glm     GLM ueber z.ai (claude-CLI headless, braucht ZAI_API_KEY)

Fehlt das gewaehlte Werkzeug oder der Zugang, bricht das Script ehrlich ab,
statt eine Analyse vorzutaeuschen.
"""

import argparse
import datetime
import json
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys

# Bewusst terra, NICHT sol: agent_review laeuft seit 2026-07-31 auf sol, weil
# es das Gate bedient und ein Fehler dort am teuersten ist. Hier bleibt terra.
# Alle drei Werkzeuge teilen EINEN Kontingent-Pool - sol ueberall waere der
# schnellste Weg, das Review-Gate per leerem Kontingent selbst zu blockieren.
# Effort bleibt bei "medium" gedeckelt, gleiche Begruendung wie dort.
DEFAULT_MODEL = "gpt-5.6-terra"
EFFORT_CHOICES = ["low", "medium"]
DEFAULT_EFFORT = "medium"

# Zweites Backend: GLM ueber den Anthropic-kompatiblen z.ai-Endpunkt, gefahren
# mit der claude-CLI headless. Ausfuehrliche Begruendung und die Messungen
# stehen in agent_review - hier nur das Noetigste:
#
# Isolierung leistet `--safe-mode`, NICHT `--bare` (gemessen auf claude-CLI
# 2.1.220). Ohne sie zieht der Ermittler die globale ~/.claude/CLAUDE.md mit in
# den Kontext, also die Chat-Stil- und Orchestrierungsregeln des Nutzers.
#
# `--tools Read,Grep,Glob` ist hier das Gegenstueck zur codex-Sandbox
# `--sandbox read-only`: der Ermittler diagnostiziert, er repariert nicht, und
# kann den Arbeitsbaum der laufenden Session nicht anfassen.
DEFAULT_GLM_MODEL = "glm-5.2"
ZAI_BASE_URL = "https://api.z.ai/api/anthropic"
BACKENDS = ["codex", "glm"]
DEFAULT_BACKEND = "codex"

HUNT_INSTRUCTIONS = """Du bist ein Root-Cause-Ermittler in einem fremden Repository.
Deine Aufgabe ist DIAGNOSE, nicht Reparatur. Du arbeitest read-only.

Problem:
{problem}
{hint_block}
Vorgehen:
1. Reproduziere den Fehlerpfad gedanklich anhand des Codes (Dateien lesen,
   greppen, Git-History ansehen - was immer read-only geht).
2. Bilde Hypothesen und pruefe jede gegen den tatsaechlichen Code, bevor du
   sie meldest. Eine Hypothese ohne Belegstelle ist keine.
3. Unterscheide klar: belegte Ursache vs. plausible Vermutung.

Antwortformat (Markdown):
## Root-Cause-Hypothesen (absteigend nach Konfidenz)
Pro Hypothese:
- **These:** ein Satz
- **Konfidenz:** hoch / mittel / niedrig
- **Beleg:** Datei:Zeile plus kurzes Zitat des relevanten Codes
- **Mechanismus:** wie genau fuehrt das zum beobachteten Verhalten
- **Verifikation:** welcher konkrete Check/Testlauf wuerde die These bestaetigen
  oder widerlegen (nur benennen, nicht ausfuehren, wenn er Schreibzugriff braucht)

## Ausgeschlossen
Was du geprueft und verworfen hast, mit Begruendung.

Keine Fixes vorschlagen, bevor die Ursache steht. Wenn du nichts Belastbares
findest, sag das ehrlich - eine leere Hypothesenliste ist besser als eine
erfundene."""


def now():
    return datetime.datetime.now().isoformat(timespec="seconds")


def record_command(repo, command, exit_code):
    agents = repo / ".agents"
    agents.mkdir(exist_ok=True)
    with (agents / "command_runs.jsonl").open("a", encoding="utf-8") as f:
        f.write(
            json.dumps(
                {"command": command, "exit_code": exit_code, "ts": now()},
                ensure_ascii=False,
            )
            + "\n"
        )


def find_codex():
    """Die Tool-Shell hat nicht denselben PATH wie die Login-Shell."""
    exe = shutil.which("codex")
    if exe:
        return exe
    for cand in (
        "/usr/local/bin/codex",
        "/opt/homebrew/bin/codex",
        os.path.expanduser("~/.local/bin/codex"),
    ):
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def find_claude():
    """Wie find_codex, nur fuer die claude-CLI (GLM-Backend)."""
    exe = shutil.which("claude")
    if exe:
        return exe
    for cand in (
        "/usr/local/bin/claude",
        "/opt/homebrew/bin/claude",
        os.path.expanduser("~/.local/bin/claude"),
    ):
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def zai_key():
    """z.ai-Key aus der Umgebung, sonst aus der Login-Shell nachladen.

    Gleicher Grund wie bei codex: die Tool-Shell erbt die zshrc nicht.
    """
    key = os.environ.get("ZAI_API_KEY", "").strip()
    if key:
        return key
    r = subprocess.run(
        ["zsh", "-lic", "print -rn -- ${ZAI_API_KEY:-}"],
        capture_output=True,
        text=True,
    )
    return (r.stdout or "").strip()


def run_glm(repo, claude_bin, key, model, prompt):
    """Read-only-Lauf ueber GLM. Rueckgabe: (output, returncode, fatal).

    `fatal` ist ein Text, wenn der Lauf gar nicht zustande kam - dann ist
    `output` wertlos und darf nicht als Ergebnis durchgehen.
    """
    env = dict(os.environ)
    env.update(
        {
            "ANTHROPIC_BASE_URL": ZAI_BASE_URL,
            # --bare authentifiziert nur ueber ANTHROPIC_API_KEY, z.ai
            # dokumentiert ANTHROPIC_AUTH_TOKEN - deshalb beide setzen.
            "ANTHROPIC_API_KEY": key,
            "ANTHROPIC_AUTH_TOKEN": key,
            "API_TIMEOUT_MS": "3000000",
            "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        }
    )
    cmd = [
        claude_bin,
        "-p",
        prompt,
        "--bare",
        "--safe-mode",
        "--add-dir",
        str(repo),
        "--model",
        model,
        "--tools",
        "Read,Grep,Glob",
    ]
    proc = subprocess.run(cmd, cwd=repo, env=env, capture_output=True, text=True)
    output = (proc.stdout or "") + (proc.stderr or "")

    # NUR stderr auf Fehlermuster pruefen, nie den ganzen Output: stdout ist die
    # Analyse und zitiert gelesenen Code. Sucht man dort nach "401", meldet ein
    # Lauf ueber dieses Script sich selbst als kaputte Anmeldung - derselbe
    # Selbstlese-Fehler, den agent_review schon einmal hatte.
    err = (proc.stderr or "").lower()
    failed = proc.returncode != 0
    if failed and "unknown option" in err:
        return (
            output,
            proc.returncode,
            "claude-CLI kennt ein benoetigtes Flag nicht - vermutlich zu alt. "
            "Abhilfe: claude update. Getestet mit 2.1.220.",
        )
    if failed and any(
        s in err for s in ("401", "unauthorized", "invalid api key", "authentication_error")
    ):
        return (
            output,
            proc.returncode,
            "z.ai-Anmeldung abgelehnt. ZAI_API_KEY pruefen "
            "(Konsole: https://z.ai/manage-apikey/apikey-list).",
        )
    if failed and any(s in err for s in ("rate limit", "quota", "usage limit", "insufficient")):
        return (
            output,
            proc.returncode,
            "z.ai-Kontingent erschoepft. Warten bis zum Reset oder Tier anheben.",
        )
    return output, proc.returncode, None


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("problem", help="Beschreibung des beobachteten Fehlverhaltens")
    ap.add_argument("--repo", default=".", help="Repo-Pfad (Default: aktuelles Verzeichnis)")
    ap.add_argument(
        "--hint",
        help="optionaler Hinweis (Verdachtsdateien, Zeitpunkt, Repro-Schritte)",
    )
    ap.add_argument(
        "--backend",
        default=DEFAULT_BACKEND,
        choices=BACKENDS,
        help=f"Zweitmodell-Backend (Default: {DEFAULT_BACKEND})",
    )
    ap.add_argument(
        "--model",
        default=None,
        help=(
            f"Modell des Ermittlers (Default: {DEFAULT_GLM_MODEL} bei glm, "
            f"{DEFAULT_MODEL} bei codex)"
        ),
    )
    ap.add_argument(
        "--effort",
        default=DEFAULT_EFFORT,
        choices=EFFORT_CHOICES,
        help=f"Reasoning-Effort, gedeckelt bei medium (Default: {DEFAULT_EFFORT})",
    )
    args = ap.parse_args()

    repo = pathlib.Path(args.repo).resolve()
    if not (repo / ".git").exists():
        print(f"FEHLER: kein Git-Repo: {repo}", file=sys.stderr)
        return 2

    key = ""
    if args.backend == "glm":
        backend_bin = find_claude()
        if not backend_bin:
            print("FEHLER: claude-CLI nicht gefunden (Backend glm).", file=sys.stderr)
            print("Keine Analyse vorzutaeuschen ist besser als eine erfundene.", file=sys.stderr)
            return 2
        key = zai_key()
        if not key:
            print("FEHLER: ZAI_API_KEY nicht gesetzt (Backend glm).", file=sys.stderr)
            return 2
        args.model = args.model or DEFAULT_GLM_MODEL
    else:
        backend_bin = find_codex()
        if not backend_bin:
            print(
                "FEHLER: codex-CLI nicht gefunden. Kein Zweitmodell = kein Hunt.", file=sys.stderr
            )
            print("Keine Analyse vorzutaeuschen ist besser als eine erfundene.", file=sys.stderr)
            return 2
        args.model = args.model or DEFAULT_MODEL

    hint_block = f"\nHinweis vom Auftraggeber:\n{args.hint}\n" if args.hint else ""
    prompt = HUNT_INSTRUCTIONS.format(problem=args.problem, hint_block=hint_block)

    effort_desc = f", effort={args.effort}" if args.backend == "codex" else ""
    print(f"Zweitmodell ermittelt in: {repo.name} [{args.backend}: {args.model}{effort_desc}]")
    print(f"Problem: {args.problem}\n")

    glm_fatal = None
    if args.backend == "glm":
        output, returncode, glm_fatal = run_glm(repo, backend_bin, key, args.model, prompt)
    else:
        # Read-only-Sandbox: der Ermittler diagnostiziert, er repariert nicht.
        # Damit kann er auch keinen Zustand zerstoeren, waehrend die Session
        # parallel am selben Arbeitsbaum haengt.
        cmd = [
            backend_bin,
            "exec",
            "--sandbox",
            "read-only",
            "--model",
            args.model,
            "-c",
            f'model_reasoning_effort="{args.effort}"',
            prompt,
        ]
        # Ueber die LOGIN-Shell starten: codex braucht CODEX_HOME/OPENAI_API_KEY
        # aus der zshrc. Ein direkter subprocess erbt die nicht und laeuft in
        # einen irrefuehrenden "Login abgelaufen"-Fehler.
        shell_cmd = " ".join(shlex.quote(c) for c in cmd)
        proc = subprocess.run(["zsh", "-lic", shell_cmd], cwd=repo, capture_output=True, text=True)
        output = (proc.stdout or "") + (proc.stderr or "")
        returncode = proc.returncode

    if glm_fatal:
        print(f"HUNT NICHT GELAUFEN (glm): {glm_fatal}", file=sys.stderr)
        record_command(repo, "agent_hunt --backend glm", 2)
        return 2

    # NUR echte codex-Fehlerzeilen auswerten, nicht die gesamte Ausgabe - der
    # Output enthaelt gelesenen REPO-CODE, und der kann die Suchmuster selbst
    # enthalten (agent_review ist genau daran schon einmal gescheitert).
    error_lines = "\n".join(
        line for line in output.splitlines() if line.strip().startswith("ERROR:")
    )
    # Diese Muster sind codex-Sprache. Beim GLM-Backend hat run_glm bereits
    # auf stderr geprueft und ueber glm_fatal gemeldet.
    failed = returncode != 0 and args.backend == "codex"

    auth_broken = failed and any(
        s in error_lines
        for s in (
            "token_expired",
            "401 Unauthorized",
            "refresh token was already used",
            "Please log out and sign in again",
        )
    )
    if auth_broken:
        print("HUNT NICHT GELAUFEN: codex-Login abgelaufen.", file=sys.stderr)
        print("Behebung (interaktives Terminal noetig):  codex login", file=sys.stderr)
        record_command(repo, "agent_hunt", 2)
        return 2

    quota_hit = failed and any(
        s in error_lines
        for s in ("hit your usage limit", "usage_limit_reached", "rate_limit_exceeded")
    )
    if quota_hit:
        print("HUNT NICHT GELAUFEN: codex-Kontingent erschoepft.", file=sys.stderr)
        for line in output.splitlines():
            if "usage limit" in line:
                print(f"  {line.strip()}", file=sys.stderr)
                break
        record_command(repo, "agent_hunt", 2)
        return 2

    print(output)

    hunts = repo / ".agents" / "hunts"
    hunts.mkdir(parents=True, exist_ok=True)
    stamp = now().replace(":", "").replace("-", "")
    slug = re.sub(r"[^a-z0-9]+", "-", args.problem.lower())[:40].strip("-") or "hunt"
    out_file = hunts / f"{stamp}-{slug}.md"
    out_file.write_text(
        f"# Cross-Model-Hunt\n\n"
        f"- Zeitpunkt: {now()}\n"
        f"- Repo: {repo.name}\n"
        f"- Problem: {args.problem}\n"
        + (f"- Hinweis: {args.hint}\n" if args.hint else "")
        + f"- Backend: {args.backend} ({backend_bin}, Modell {args.model})\n"
        f"- Exit: {returncode}\n\n"
        f"---\n\n{output}\n",
        encoding="utf-8",
    )

    backend_flag = "" if args.backend == DEFAULT_BACKEND else f" --backend {args.backend}"
    record_command(repo, f"tools/agent_hunt{backend_flag}", returncode)

    print(f"\nHunt gespeichert: {out_file.relative_to(repo)}")
    if returncode != 0:
        print(
            "HINWEIS: Ermittler endete mit Fehler - Ergebnis ist unvollstaendig.",
            file=sys.stderr,
        )
    return returncode


if __name__ == "__main__":
    sys.exit(main())
